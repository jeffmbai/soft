# Copy to .env for local Docker Compose: cp .env.example .env

# Domains (production)
DOMAIN=soft.serverops.co.ke
API_DOMAIN=softapi.serverops.co.ke
SSL_CERT_DOMAINS=soft.serverops.co.ke,softapi.serverops.co.ke

# Postgres
POSTGRES_USER=shiftsync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiftsync
POSTGRES_HOST_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379

# Backend
DATABASE_URL=postgresql+asyncpg://shiftsync:change-me@db:5432/shiftsync
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
BACKEND_HOST_PORT=8000

# Frontend
FRONTEND_HOST_PORT=3000
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Deploy / CI (production)
GHCR_IMAGE_OWNER=jeffmbai
IMAGE_TAG=latest
DEPLOY_PATH=/opt/soft
GATEWAY_SITE_NAME=soft
SHARED_PROXY_NETWORK_NAME=serverops_proxy
CERTBOT_EMAIL=admin@example.com

# Production: services are not bound to host ports on the shared VPS.
# Public traffic routes via serverops-gateway → soft-frontend:3000 / soft-backend:8000
